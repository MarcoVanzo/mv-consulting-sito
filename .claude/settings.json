{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git stash:*)",
      "Bash(git restore:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(du:*)",
      "Bash(file:*)",
      "Bash(find:*)",
      "Bash(rg:*)",
      "Bash(grep:*)",
      "Bash(php -l:*)",
      "Bash(php -S:*)",
      "Bash(curl:*)",
      "Bash(.claude/scripts/anteprima.sh:*)",
      "Bash(.claude/scripts/controlla.sh:*)",
      "Bash(.claude/scripts/stato.sh:*)",
      "Read(//home/user/mv-consulting-sito/**)",
      "Edit(//home/user/mv-consulting-sito/**)",
      "Write(//home/user/mv-consulting-sito/**)",
      "mcp__github__actions_list",
      "mcp__github__actions_get",
      "mcp__github__get_job_logs",
      "mcp__github__list_commits",
      "mcp__github__list_branches",
      "mcp__github__get_file_contents",
      "mcp__github__pull_request_read",
      "mcp__github__list_pull_requests"
    ],
    "deny": [
      "Read(//home/user/mv-consulting-sito/.env)",
      "Read(//home/user/mv-consulting-sito/.env.*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/scripts/stato.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}

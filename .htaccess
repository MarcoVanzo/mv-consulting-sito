# mv-consulting.it — configurazione Apache (hosting Aruba)

# --- Pagina iniziale --------------------------------------------------------
# index.html prima di index.php: finché restano file WordPress sul server,
# senza questa riga il vecchio index.php continuerebbe a servire il sito.
DirectoryIndex index.html index.php

# --- HTTPS e www ------------------------------------------------------------
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://www.mv-consulting.it/$1 [R=301,L]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^(.*)$ https://www.mv-consulting.it/$1 [R=301,L]

# --- Vecchi indirizzi WordPress --------------------------------------------
# Le pagine del vecchio sito confluiscono nelle sezioni della nuova home:
# senza questi redirect i link esistenti e i risultati di ricerca finirebbero su 404.
# Si usa RewriteRule e non Redirect: quest'ultimo compone la destinazione con
# lo schema visto dal server (http, perche' l'HTTPS termina sul proxy) e
# riattacca la query string dopo l'ancora, producendo /#studio?x=1.
RewriteRule ^chi-siamo/?$      https://www.mv-consulting.it/#studio          [R=301,L,QSD]
RewriteRule ^servizi/?$        https://www.mv-consulting.it/#aree            [R=301,L,QSD]
RewriteRule ^partner/?$        https://www.mv-consulting.it/#progetti        [R=301,L,QSD]
RewriteRule ^contatti/?$       https://www.mv-consulting.it/#contatti        [R=301,L,QSD]
RewriteRule ^privacy-policy/?$ https://www.mv-consulting.it/privacy-policy.html [R=301,L,QSD]

# Residui dell'installazione WordPress: non esistono più, meglio dirlo subito
RedirectMatch 410 ^/(wp-admin|wp-login\.php|wp-json|xmlrpc\.php|wp-content|wp-includes)

# --- Pagina di errore -------------------------------------------------------
ErrorDocument 404 /404.html

# --- Compressione -----------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json image/svg+xml
</IfModule>

# --- Cache ------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  # Le pagine restano poco in cache: il proxy di Aruba le trattiene a lungo e
  # una correzione ai testi impiegherebbe settimane a comparire.
  ExpiresByType text/html               "access plus 5 minutes"
</IfModule>

# --- Intestazioni di sicurezza ---------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  # Il sito non carica nulla da domini esterni: la policy può restare stretta.
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; form-action 'self'; frame-ancestors 'self'; base-uri 'self'"

  # --- Se si accende la misurazione delle campagne ---------------------------
  # Gli identificativi si impostano in assets/js/main.js (oggetto MISURAZIONE).
  # Senza le righe qui sotto la policy blocca gli script dei rispettivi domini:
  # commentare la riga precedente e togliere il commento a UNA di queste,
  # tenendo solo i domini dei servizi effettivamente attivati.
  #
  # Google Analytics 4:
  # Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: https://www.google-analytics.com https://*.googletagmanager.com; style-src 'self'; script-src 'self' https://*.googletagmanager.com; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; form-action 'self'; frame-ancestors 'self'; base-uri 'self'"
  #
  # Meta Pixel (Facebook e Instagram):
  # Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: https://www.facebook.com; style-src 'self'; script-src 'self' https://connect.facebook.net; connect-src 'self' https://www.facebook.com; form-action 'self'; frame-ancestors 'self'; base-uri 'self'"
  #
  # LinkedIn Insight Tag:
  # Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: https://px.ads.linkedin.com https://*.licdn.com; style-src 'self'; script-src 'self' https://snap.licdn.com; connect-src 'self' https://px.ads.linkedin.com; form-action 'self'; frame-ancestors 'self'; base-uri 'self'"
  Header always set Strict-Transport-Security "max-age=31536000"
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>
</IfModule>

# --- File da non servire ----------------------------------------------------
<FilesMatch "^(README\.md|\.gitignore)$">
  Require all denied
</FilesMatch>

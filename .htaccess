# mv-consulting.it — configurazione Apache (hosting Aruba)

# --- Pagina iniziale --------------------------------------------------------
# index.html prima di index.php: finché restano file WordPress sul server,
# senza questa riga il vecchio index.php continuerebbe a servire il sito.
DirectoryIndex index.html index.php

# --- HTTPS e www ------------------------------------------------------------
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://www.mv-consulting.it/$1 [R=301,L]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^(.*)$ https://www.mv-consulting.it/$1 [R=301,L]

# --- Vecchi indirizzi WordPress --------------------------------------------
# Le pagine del vecchio sito confluiscono nelle sezioni della nuova home:
# senza questi redirect i link esistenti e i risultati di ricerca finirebbero su 404.
# Si usa RewriteRule e non Redirect: quest'ultimo compone la destinazione con
# lo schema visto dal server (http, perche' l'HTTPS termina sul proxy) e
# riattacca la query string dopo l'ancora, producendo /#studio?x=1.
RewriteRule ^chi-siamo/?$      https://www.mv-consulting.it/#studio          [R=301,L,QSD,NE]
RewriteRule ^servizi/?$        https://www.mv-consulting.it/#aree            [R=301,L,QSD,NE]
RewriteRule ^partner/?$        https://www.mv-consulting.it/#progetti        [R=301,L,QSD,NE]
RewriteRule ^contatti/?$       https://www.mv-consulting.it/#contatti        [R=301,L,QSD,NE]
RewriteRule ^privacy-policy/?$ https://www.mv-consulting.it/privacy-policy.html [R=301,L,QSD,NE]
# La cookie policy è una sezione dell'informativa: chi cerca l'indirizzo storico
# o quello che ci si aspetta di trovare finisce direttamente su quella sezione.
RewriteRule ^cookie-policy/?$  https://www.mv-consulting.it/privacy-policy.html#cookie [R=301,L,QSD,NE]
RewriteRule ^privacy/?$        https://www.mv-consulting.it/privacy-policy.html [R=301,L,QSD,NE]

# Residui dell'installazione WordPress: non esistono più, meglio dirlo subito
RedirectMatch 410 ^/(wp-admin|wp-login\.php|wp-json|xmlrpc\.php|wp-content|wp-includes)

# --- File che nessuno deve chiedere dal browser ------------------------------
# config-smtp.php contiene la password della casella di posta. Finché PHP
# funziona non uscirebbe comunque niente — un .php viene eseguito, non mostrato
# — ma il giorno in cui l'hosting perde il gestore PHP i .php diventano file di
# testo, e quella password sarebbe pubblica. Questa riga costa nulla e copre
# proprio quel giorno. invio-smtp.php dichiara solo funzioni: chiamarlo da fuori
# non fa danni, ma non ha senso.
# Si passa da mod_alias e non da <Files>/Require: la direttiva giusta cambia
# fra Apache 2.2 e 2.4, e sbagliarla qui significa un 500 su tutto il sito.
# Un RedirectMatch vale ovunque e riguarda solo le richieste dal browser: il
# require di contatti.php legge dal disco e non passa di qui.
RedirectMatch 404 ^/(config-smtp\.php|config-smtp\.esempio\.php|invio-smtp\.php)$

# --- Pagina di errore -------------------------------------------------------
ErrorDocument 404 /404.html

# --- Compressione -----------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json image/svg+xml
</IfModule>

# --- Cache ------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  # CSS e JS stanno in cache una settimana, non un anno. Gli indirizzi portano
  # gia' l'impronta del file, quindi una versione nuova arriva subito comunque e
  # accorciare non costa velocita'. Costa invece tenerli un anno: il 6 agosto
  # 2026 il proxy di Aruba ha memorizzato la copia precedente di style.css sotto
  # l'indirizzo versionato nuovo — bastano pochi secondi di disallineamento fra
  # il file caricato e la prima lettura — e quella copia sarebbe rimasta servita
  # per dodici mesi. Con una settimana lo stesso incidente si riassorbe da solo.
  ExpiresByType text/css                "access plus 1 week"
  ExpiresByType application/javascript  "access plus 1 week"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  # Le pagine restano poco in cache: il proxy di Aruba le trattiene a lungo e
  # una correzione ai testi impiegherebbe settimane a comparire.
  ExpiresByType text/html               "access plus 5 minutes"
</IfModule>

# --- Intestazioni di sicurezza ---------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  # Domini esterni ammessi: Cookiebot (banner di consenso), Google Analytics,
  # pixel di Meta e Insight Tag di LinkedIn. Gli ultimi due restano comunque fermi
  # finché non c'è il consenso "marketing": la CSP dice che cosa può essere
  # caricato, non decide se caricarlo — quello lo fa Cookiebot. 'unsafe-inline' su
  # script-src serve al blocco automatico di Cookiebot, che riscrive i tag
  # <script> della pagina: senza, il banner non parte.
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: https://imgsct.cookiebot.com https://*.google-analytics.com https://*.googletagmanager.com https://www.facebook.com https://px.ads.linkedin.com https://px4.ads.linkedin.com; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://consent.cookiebot.com https://consentcdn.cookiebot.com https://*.googletagmanager.com https://connect.facebook.net https://snap.licdn.com; connect-src 'self' https://consent.cookiebot.com https://consentcdn.cookiebot.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://www.facebook.com https://px.ads.linkedin.com; frame-src https://consentcdn.cookiebot.com https://www.facebook.com; form-action 'self'; frame-ancestors 'self'; base-uri 'self'"
  Header always set Strict-Transport-Security "max-age=31536000"
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>
</IfModule>

# --- File da non servire ----------------------------------------------------
<FilesMatch "^(README\.md|CLAUDE\.md|\.gitignore)$">
  Require all denied
</FilesMatch>

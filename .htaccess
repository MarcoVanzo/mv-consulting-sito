# mv-consulting.it — configurazione Apache (hosting Aruba)

# --- Pagina iniziale --------------------------------------------------------
# index.html prima di index.php: finché restano file WordPress sul server,
# senza questa riga il vecchio index.php continuerebbe a servire il sito.
DirectoryIndex index.html index.php

# --- HTTPS e www ------------------------------------------------------------
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://www.mv-consulting.it/$1 [R=301,L]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^(.*)$ https://www.mv-consulting.it/$1 [R=301,L]

# --- Vecchi indirizzi WordPress --------------------------------------------
# Le pagine del vecchio sito confluiscono nelle sezioni della nuova home:
# senza questi redirect i link esistenti e i risultati di ricerca finirebbero su 404.
# Si usa RewriteRule e non Redirect: quest'ultimo compone la destinazione con
# lo schema visto dal server (http, perche' l'HTTPS termina sul proxy) e
# riattacca la query string dopo l'ancora, producendo /#studio?x=1.
RewriteRule ^chi-siamo/?$      https://www.mv-consulting.it/#studio          [R=301,L,QSD]
RewriteRule ^servizi/?$        https://www.mv-consulting.it/#aree            [R=301,L,QSD]
RewriteRule ^partner/?$        https://www.mv-consulting.it/#progetti        [R=301,L,QSD]
RewriteRule ^contatti/?$       https://www.mv-consulting.it/#contatti        [R=301,L,QSD]
RewriteRule ^privacy-policy/?$ https://www.mv-consulting.it/privacy-policy.html [R=301,L,QSD]

# Residui dell'installazione WordPress: non esistono più, meglio dirlo subito
RedirectMatch 410 ^/(wp-admin|wp-login\.php|wp-json|xmlrpc\.php|wp-content|wp-includes)

# --- Pagina di errore -------------------------------------------------------
ErrorDocument 404 /404.html

# --- Compressione -----------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json image/svg+xml
</IfModule>

# --- Cache ------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  # Le pagine restano poco in cache: il proxy di Aruba le trattiene a lungo e
  # una correzione ai testi impiegherebbe settimane a comparire.
  ExpiresByType text/html               "access plus 5 minutes"
</IfModule>

# --- Intestazioni di sicurezza ---------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  # --- Content-Security-Policy -----------------------------------------------
  # style-src ha bisogno di 'unsafe-inline': le tre schede progetto prendono i
  # colori del rispettivo marchio da un attributo style="--p:...", e le pagine
  # dell'informativa e dell'errore hanno un blocco <style>. Con la sola
  # 'self' il browser li rifiutava e in produzione i progetti uscivano tutti
  # dello stesso blu, con i campioni di palette invisibili. Serve comunque
  # anche a Cookiebot, che disegna il banner con stili in linea.
  #
  # script-src resta senza 'unsafe-inline': nessuna pagina ha JavaScript in
  # linea. Per questo il blocco dei cookie di Cookiebot è impostato in modo
  # manuale e non automatico — il blocco automatico riscrive i tag <script> e
  # la documentazione di Cookiebot avverte che non convive con una CSP.
  #
  # Sono elencati sia i domini .com sia i .eu di Cookiebot: se in futuro si
  # attiva la consegna dal CDN europeo, la policy non va ritoccata.
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: https://imgsct.cookiebot.com https://imgsct.cookiebot.eu; style-src 'self' 'unsafe-inline'; script-src 'self' https://consent.cookiebot.com https://consentcdn.cookiebot.com https://consent.cookiebot.eu https://consentcdn.cookiebot.eu; connect-src 'self' https://consent.cookiebot.com https://consentcdn.cookiebot.com https://consent.cookiebot.eu https://consentcdn.cookiebot.eu; frame-src https://consentcdn.cookiebot.com https://consentcdn.cookiebot.eu; form-action 'self'; frame-ancestors 'self'; base-uri 'self'"

  # --- Se si accende la misurazione delle campagne ---------------------------
  # Gli identificativi si impostano in assets/js/main.js (oggetto MISURAZIONE).
  # Senza i domini qui sotto la policy blocca gli script: si commenta la riga
  # precedente e si toglie il commento a UNA di queste, che sono la policy
  # completa (Cookiebot incluso) più i domini del servizio scelto. Attivandone
  # più di uno, si uniscono le liste a mano in una sola riga.
  #
  # Google Analytics 4:
  # Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: https://imgsct.cookiebot.com https://imgsct.cookiebot.eu https://www.google-analytics.com https://*.googletagmanager.com; style-src 'self' 'unsafe-inline'; script-src 'self' https://consent.cookiebot.com https://consentcdn.cookiebot.com https://consent.cookiebot.eu https://consentcdn.cookiebot.eu https://*.googletagmanager.com; connect-src 'self' https://consent.cookiebot.com https://consentcdn.cookiebot.com https://consent.cookiebot.eu https://consentcdn.cookiebot.eu https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; frame-src https://consentcdn.cookiebot.com https://consentcdn.cookiebot.eu; form-action 'self'; frame-ancestors 'self'; base-uri 'self'"
  #
  # Meta Pixel (Facebook e Instagram):
  # Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: https://imgsct.cookiebot.com https://imgsct.cookiebot.eu https://www.facebook.com; style-src 'self' 'unsafe-inline'; script-src 'self' https://consent.cookiebot.com https://consentcdn.cookiebot.com https://consent.cookiebot.eu https://consentcdn.cookiebot.eu https://connect.facebook.net; connect-src 'self' https://consent.cookiebot.com https://consentcdn.cookiebot.com https://consent.cookiebot.eu https://consentcdn.cookiebot.eu https://www.facebook.com; frame-src https://consentcdn.cookiebot.com https://consentcdn.cookiebot.eu; form-action 'self'; frame-ancestors 'self'; base-uri 'self'"
  #
  # LinkedIn Insight Tag:
  # Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: https://imgsct.cookiebot.com https://imgsct.cookiebot.eu https://px.ads.linkedin.com https://*.licdn.com; style-src 'self' 'unsafe-inline'; script-src 'self' https://consent.cookiebot.com https://consentcdn.cookiebot.com https://consent.cookiebot.eu https://consentcdn.cookiebot.eu https://snap.licdn.com; connect-src 'self' https://consent.cookiebot.com https://consentcdn.cookiebot.com https://consent.cookiebot.eu https://consentcdn.cookiebot.eu https://px.ads.linkedin.com; frame-src https://consentcdn.cookiebot.com https://consentcdn.cookiebot.eu; form-action 'self'; frame-ancestors 'self'; base-uri 'self'"
  Header always set Strict-Transport-Security "max-age=31536000"
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>
</IfModule>

# --- File da non servire ----------------------------------------------------
<FilesMatch "^(README\.md|\.gitignore)$">
  Require all denied
</FilesMatch>
